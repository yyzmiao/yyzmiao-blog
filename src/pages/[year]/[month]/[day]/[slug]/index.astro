---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Giscus from '../../../../../components/Giscus.astro';
import { formatDate, postUrl, readingTime } from '../../../../../utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => {
    const [year, month, day, slug] = postUrl(post).split('/').filter(Boolean);
    return { params: { year, month, day, slug }, props: { post } };
  });
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.seoDescription ?? post.data.description}
  canonical={postUrl(post)}
  type="article"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}>
  <article class="article-shell" data-pagefind-body>
    <div>
      <header class="article-header">
        <p class="eyebrow">Technical note</p>
        <h1 data-pagefind-meta="title">{post.data.title}</h1>
        <p class="article-deck">{post.data.description}</p>
        <div class="article-meta">
          <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
          <span>约 {readingTime(post.body ?? '')} 分钟</span>
          {post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
        </div>
      </header>
      <div class="prose"><Content /></div>
    </div>
    {toc.length > 0 && <aside class="article-toc" aria-label="文章目录"><strong>ON THIS PAGE</strong><ul>{toc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></aside>}
  </article>
  <Giscus />
</BaseLayout>
